# Copy this file to .env and fill in your values
SECRET=changeme

PORT=3000
CONFIG_DIR=./config
TEST_INTERVAL=3600
# where the client posts results — use localhost if server+client run on the same host,
# otherwise the server host's address, e.g. http://192.168.1.50:3000/save
SERVER_URL=http://localhost:3000/save
# tags this machine's readings in the dashboard, e.g. "wifi" or "ethernet"
CONNECTION_LABEL=wifi
# host interface to read the MAC from, e.g. eth0 (check with: ip link show) — Docker only
HOST_IFACE=eth0

# dashboard outlier detection / zoom / low-speed table tunables (see README)
OUTLIER_THRESHOLD=1.5
MAD_CONSISTENCY_CONSTANT=0.6745
MIN_RANGE_MS=60000
LOW_SPEED_THRESHOLD_MBPS=10.0
